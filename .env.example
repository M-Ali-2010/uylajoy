# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Production: the Supabase TRANSACTION POOLER (port 6543). The direct host db.<ref>.supabase.co
# is IPv6-only and unreachable from Vercel; the aws-N prefix must match the project's pooler host.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/uyjoy

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=your-bot-token

# Payme (payment provider)
PAYME_MERCHANT_ID=your-merchant-id
PAYME_SECRET_KEY=your-secret-key
PAYME_TEST_KEY=your-test-key
PAYME_IS_TEST=true

# Click (payment provider)
CLICK_MERCHANT_ID=your-merchant-id
CLICK_SERVICE_ID=your-service-id
CLICK_SECRET_KEY=your-secret-key
